# Vidroa Environment Configuration
# NOTE: No .env file is loaded automatically at startup — export these variables
# in your shell environment or configure API keys directly in the app Settings tab.

# Groq LLM Inference (single key or comma-separated pool)
GROQ_API_KEY=
GROQ_API_KEYS=

# Stock B-Roll Video Search Keys (Optional — configure in Settings or export here)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Local / Custom Backend Settings
PROMPTBEAST_API_URL=http://127.0.0.1:8000
PROMPTBEAST_API_KEY=
AUTH_TOKEN=

# Model Runtime Settings
MODEL_NAME=qwen/qwen3.8-27b
MODEL_HF_PATH=qwen/qwen3.8-27b
